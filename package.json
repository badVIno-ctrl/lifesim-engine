{
	"name": "sim-v13",
	"version": "13.1.0",
	"private": true,
	"type": "module",
	"description": "Текстовый симулятор мира на LLM: детерминированное ядро + PWA-оболочка",
	"engines": {
		"node": ">=20.11"
	},
	"scripts": {
		"dev": "vite",
