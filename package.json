		"@types/react-dom": "^18.3.5",
		"@vitejs/plugin-react": "^4.3.4",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vite": "^5.4.11",
		"vite-plugin-pwa": "^0.21.1"
	}
